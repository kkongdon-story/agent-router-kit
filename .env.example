# Agent Router Kit env
# Copy this to your local secrets file. Never commit real token values.

SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_CHANNEL=C0XXXXXXXXX
USER_SLACK_ID=U0XXXXXXXXX
BOT_USER_ID=

SLACK_BOT_NAME=Agent Router Kit
USER_NAME=사용자
DEFAULT_AGENT=codex

# Local CLI launchers.
# Windows examples:
#   CLAUDE_EXE=C:\Users\you\.local\bin\claude.exe
#   CODEX_EXE=C:\nvm4w\nodejs\codex.ps1
# macOS/Linux examples:
#   CLAUDE_EXE=claude
#   CODEX_EXE=codex
CLAUDE_EXE=claude
CODEX_EXE=codex
POWERSHELL_EXE=pwsh

# Local folders.
WORKSPACE_ROOT={USER_HOME}/agent-router-workspace
AGENT_WORKDIR={USER_HOME}/agent-router-workspace
PROJECT_ROOT={USER_HOME}/agent-router-projects

# Optional modules.
ENABLE_KMS=1
ENABLE_SMS=0
ENABLE_KAKAO=0

# Long local tasks need enough time.
AGENT_TIMEOUT_SEC=900
DEBATE_STATE_TTL_SEC=43200

